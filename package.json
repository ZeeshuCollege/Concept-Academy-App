{
  "name": "concept-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cap:sync": "vite build && npx cap sync android",
    "build:apk": "node scripts/auto-build-apk.cjs",
    "watch:apk": "node scripts/watch-apk.cjs",
    "bundle:release": "vite build && npx cap sync android && cd android && gradlew.bat bundleRelease && cd .. && powershell -Command \"Copy-Item android/app/build/outputs/bundle/release/app-release.aab -Destination ConceptAcademy-release.aab -Force\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@libsql/client": "^0.18.0",
    "@supabase/supabase-js": "^2.48.1",
    "canvas-confetti": "^1.9.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0"
  }
}
