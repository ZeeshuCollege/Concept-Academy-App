# =============================================================================
# CONCEPT ACADEMY - ENVIRONMENT TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env and fill in your values.
# Do not commit real production tokens or secret keys to git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. TURSO DATABASE (libSQL / Serverless SQLite for Users & Academic Records)
# Create database: turso db create concept-academy
# Apply schema:    turso db shell concept-academy < turso_schema.sql
# -----------------------------------------------------------------------------
VITE_TURSO_DATABASE_URL=libsql://concept-academy-yourorg.turso.io
VITE_TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here
TURSO_DATABASE_URL=libsql://concept-academy-yourorg.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# -----------------------------------------------------------------------------
# 2. ORACLE CLOUD (OCI) OBJECT STORAGE (For PDFs, Study Materials & Media)
# OCI Object Storage provides 20 GB Always Free tier.
#
# Option A (Recommended): Pre-Authenticated Request (PAR) for secure client upload/view
#   VITE_ORACLE_STORAGE_PAR_URL=https://objectstorage.ap-mumbai-1.oraclecloud.com/p/your-par-token/n/your-namespace/b/concept-academy-materials/o/
#
# Option B: Direct Public/Read Bucket
#   VITE_ORACLE_STORAGE_NAMESPACE=your_tenancy_namespace
#   VITE_ORACLE_STORAGE_BUCKET=concept-academy-materials
#   VITE_ORACLE_STORAGE_REGION=ap-mumbai-1
# -----------------------------------------------------------------------------
VITE_ORACLE_STORAGE_NAMESPACE=your_oci_tenancy_namespace
VITE_ORACLE_STORAGE_BUCKET=concept-academy-materials
VITE_ORACLE_STORAGE_REGION=ap-mumbai-1
VITE_ORACLE_STORAGE_PAR_URL=
VITE_ORACLE_STORAGE_ENDPOINT=https://your_oci_tenancy_namespace.compat.objectstorage.ap-mumbai-1.oraclecloud.com
ORACLE_STORAGE_ACCESS_KEY_ID=
ORACLE_STORAGE_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION (Optional Secondary Backend)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 4. META WHATSAPP CLOUD API (Optional OTP Dispatch)
# -----------------------------------------------------------------------------
VITE_META_PHONE_ID=
VITE_META_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_OTP_TEMPLATE_NAME=concept_academy_auth_otp

# -----------------------------------------------------------------------------
# 5. ROOT ADMIN CONFIGURATION (Local / Default Seed)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=conceptacademy@outlook.com
ADMIN_PHONE=+917738578685
ADMIN_PASSWORD=
